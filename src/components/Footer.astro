---
import { AUTHOR, NAV } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="wrap grid">
		<div>
			<p class="big">Construyamos algo<br /><em class="serif-italic">que se use de verdad.</em></p>
			<a class="btn primary" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email} ↗</a>
		</div>
		<div class="cols">
			<div>
				<span class="eyebrow">Sitio</span>
				<ul>
					{NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
				</ul>
			</div>
			<div>
				<span class="eyebrow">En línea</span>
				<ul>
					<li><a href={AUTHOR.github} target="_blank" rel="noopener">GitHub ↗</a></li>
					<li><a href={AUTHOR.orcid} target="_blank" rel="noopener">ORCID ↗</a></li>
					<li><a href="/rss.xml">RSS</a></li>
				</ul>
			</div>
		</div>
	</div>
	<div class="wrap legal">
		<span>© {year} {AUTHOR.name}</span>
		<span>{AUTHOR.location}</span>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--line);
		padding: 5rem 0 2rem;
		background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.03));
	}
	.grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 3rem;
	}
	.big {
		font-family: var(--font-display);
		font-size: clamp(2rem, 4.4vw, 3.3rem);
		line-height: 1.05;
		margin-bottom: 1.6rem;
	}
	.cols {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 1rem 0 0;
	}
	li {
		margin-bottom: 0.5rem;
	}
	li a {
		text-decoration: none;
		color: var(--paper-dim);
	}
	.legal {
		display: flex;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 1rem;
		margin-top: 4rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line-soft);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
	}
	@media (max-width: 760px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.btn {
			font-size: 0.74rem;
			word-break: break-all;
		}
	}
</style>
