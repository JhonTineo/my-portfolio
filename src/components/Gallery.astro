---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	items: { src: ImageMetadata; alt: string; caption?: string }[];
}
const { items } = Astro.props;
---

{
	items.length > 0 && (
		<section class="gallery" aria-label="Galería">
			{items.map((g, i) => (
				<figure data-reveal style={`--d:${(i % 2) * 0.08}s`} class:list={{ wide: g.src.width / g.src.height > 1.9 || items.length === 1 }}>
					<a href={g.src.src} target="_blank" rel="noopener" aria-label={`Ampliar: ${g.alt}`}>
						<Image src={g.src} alt={g.alt} width={1200} />
					</a>
					{g.caption && <figcaption>{g.caption}</figcaption>}
				</figure>
			))}
		</section>
	)
}

<style>
	.gallery {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.2rem;
		margin: 3rem 0;
	}
	figure {
		margin: 0;
	}
	figure.wide {
		grid-column: 1 / -1;
	}
	figure a {
		display: block;
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--ink-3);
	}
	figure img {
		width: 100%;
		transition: transform 0.7s var(--ease);
	}
	figure a:hover img {
		transform: scale(1.02);
	}
	figcaption {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--muted);
		margin-top: 0.6rem;
		line-height: 1.5;
	}
	@media (max-width: 700px) {
		.gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
