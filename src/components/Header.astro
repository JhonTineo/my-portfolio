---
import { NAV } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
	<div class="wrap bar">
		<a href="/" class="brand" aria-label="Inicio">
			<span class="mark" aria-hidden="true">JD</span>
			<span class="brand-text">Jhon Dalton<span class="dot">.</span></span>
		</a>

		<input type="checkbox" id="nav-toggle" class="sr-only" />
		<label for="nav-toggle" class="burger" aria-label="Abrir menú"><span></span></label>

		<nav aria-label="Principal">
			{
				NAV.map((item, i) => (
					<a href={item.href} class:list={{ active: isActive(item.href) }}>
						<span class="idx">0{i + 1}</span>
						{item.label}
					</a>
				))
			}
			<a href="/#contacto" class="cta">Contacto</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		background: rgba(2, 8, 23, 0.72);
		border-bottom: 1px solid var(--line-soft);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 68px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		text-decoration: none;
		font-family: var(--font-display);
		font-size: 1.15rem;
	}
	.mark {
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 9px;
		background: var(--lime);
		color: var(--lime-ink);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 600;
		transition: transform 0.4s var(--ease);
	}
	.brand:hover .mark {
		transform: rotate(-8deg);
	}
	.dot {
		color: var(--lime);
	}
	nav {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}
	nav a {
		position: relative;
		text-decoration: none;
		font-size: 0.93rem;
		padding: 0.5rem 0.85rem;
		border-radius: 8px;
		color: var(--paper-dim);
	}
	nav a:hover {
		color: var(--paper);
	}
	nav a.active {
		color: var(--paper);
		background: var(--ink-3);
	}
	.idx {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		color: var(--muted);
		margin-right: 0.35rem;
		vertical-align: 2px;
	}
	nav a.cta {
		margin-left: 0.5rem;
		background: var(--paper);
		color: var(--ink);
		font-weight: 500;
	}
	nav a.cta:hover {
		background: #bfdbfe;
		color: var(--ink);
	}
	.burger {
		display: none;
	}

	@media (max-width: 820px) {
		.burger {
			display: grid;
			place-items: center;
			width: 42px;
			height: 42px;
			cursor: pointer;
			border: 1px solid var(--line);
			border-radius: 10px;
		}
		.burger span,
		.burger span::before,
		.burger span::after {
			content: '';
			display: block;
			width: 18px;
			height: 1.5px;
			background: var(--paper);
			position: relative;
			transition: transform 0.3s var(--ease);
		}
		.burger span::before {
			position: absolute;
			top: -6px;
		}
		.burger span::after {
			position: absolute;
			top: 6px;
		}
		nav {
			position: absolute;
			top: 68px;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 0.5rem var(--gutter) 1.2rem;
			background: var(--ink);
			border-bottom: 1px solid var(--line);
			display: none;
		}
		nav a {
			padding: 0.9rem 0.4rem;
			border-radius: 0;
			border-bottom: 1px solid var(--line-soft);
			font-size: 1.05rem;
		}
		nav a.active {
			background: none;
			color: var(--lime);
		}
		nav a.cta {
			margin: 1rem 0 0;
			text-align: center;
			border-radius: 8px;
		}
		#nav-toggle:checked ~ nav {
			display: flex;
		}
		#nav-toggle:checked ~ .burger span {
			transform: rotate(45deg);
		}
		#nav-toggle:checked ~ .burger span::before {
			transform: translateY(6px) rotate(90deg);
		}
		#nav-toggle:checked ~ .burger span::after {
			opacity: 0;
		}
	}
</style>
