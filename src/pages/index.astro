---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import foto from '../assets/jhon.jpg';
import dt1 from '../assets/logros/datathon-reconocimiento-unsm.jpg';
import dt2 from '../assets/logros/datathon-primer-lugar.jpg';
import dt3 from '../assets/logros/yumi-implementacion-emapa.jpg';
import ProjectCard from '../components/ProjectCard.astro';
import { AUTHOR, CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('proyectos', ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
const logros = (await getCollection('logros', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const stack = [
	'Python', 'FastAPI', 'LLM · RAG', 'Qdrant', 'Ollama', 'Next.js', 'React', 'Angular', 'TypeScript',
	'Flutter', 'Spring Boot', 'Django', 'PostgreSQL', 'MySQL', 'dbt', 'Supabase', 'Docker', 'Caddy', 'Linux',
];

const deploys = [
	{ name: 'cevicheria-api', tech: 'Spring Boot · MySQL', note: 'API REST multiempresa' },
	{ name: 'cevicheria-web', tech: 'Paneles por rol', note: 'Front servido en el VPS' },
	{ name: 'lector-dni', tech: 'Django · Docker · Caddy', note: 'HTTPS automático' },
	{ name: 'notaria', tech: 'Spring Boot · MySQL', note: 'Backend con chatbot' },
];
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- ============ HERO ============ -->
	<section class="hero wrap">
		<div class="hero-text">
			<span class="eyebrow lime load" style="--i:0">Ingeniería de Sistemas · UNSM · Tarapoto</span>
			<h1 class="load" style="--i:1">
				Desarrollo de Soluciones Tecnologías que <em class="serif-italic">resuelven problemas reales.</em>
			</h1>

			<div class="actions load" style="--i:3">
				<a class="btn primary" href="#destacados">Ver proyectos ↓</a>
				<a class="btn" href={`mailto:${AUTHOR.email}`}>Escríbeme</a>
				<a class="btn" href={AUTHOR.github} target="_blank" rel="noopener">GitHub ↗</a>
			</div>
		</div>

		<aside class="hero-card beam load" style="--i:2" data-tilt>
			<div class="portrait">
				<Image src={foto} alt="Foto de Jhon Dalton Huaman" width={720} loading="eager" />
			</div>
			<div class="stamp" aria-label="Primer lugar Datathon SUNASS 2026">
				<svg viewBox="0 0 120 120" aria-hidden="true">
					<defs><path id="c" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"></path></defs>
					<text><textPath href="#c">DATATHON SUNASS 2026 · PRIMER LUGAR ·</textPath></text>
				</svg>
				<span>1.º</span>
			</div>
			<div class="id">
				<strong>{AUTHOR.name}</strong>
				<span>Desarrollador de software · IA aplicada</span>
			</div>
			<dl>
				<div>
					<dt>Proyectos</dt>
					<dd>Yumi - EMAPA San Martín</dd>
					<dd>SIFC - Universidad Nacional de San Martín</dd>
					<dd>GSPOE - Gobierno Regional de San Martín</dd>
					<dd>MeryApp - Agente móvil</dd>
				</div>
				<div>
					<dt>Formación</dt>
					<dd>Ing. de Sistemas e Informática · UNSM</dd>
					<dd>Disciplina, liderazgo y compromiso</dd>
				</div>
			</dl>
		</aside>
	</section>

	<div class="marquee" aria-hidden="true">
		<div class="track">
			{[...stack, ...stack].map((s) => <span>{s}<i>/</i></span>)}
		</div>
	</div>

	<!-- ============ CIFRAS ============ -->
	<section class="wrap stats">
		<div data-reveal><strong><span data-count="1">1</span>.º</strong><span>Datathon SUNASS 2026, macrorregión Oriente</span></div>
		<div data-reveal style="--d:.08s"><strong data-count="2">2</strong><span>sistemas en uso institucional: SYSCO y UNSM</span></div>
		<div data-reveal style="--d:.16s"><strong data-count={projects.length}>{projects.length}</strong><span>proyectos documentados en este sitio</span></div>
		<div data-reveal style="--d:.24s">
			<strong>
				<svg class="server-icon" xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<rect x="3" y="3" width="18" height="7" rx="2" />
					<rect x="3" y="14" width="18" height="7" rx="2" />
					<path d="M7 6.5h.01M7 17.5h.01M11 6.5h6M11 17.5h6" />
				</svg>
			</strong>
			<span>Manejo de servidores</span>
		</div>
	</section>

	<!-- ============ DESTACADOS ============ -->
	<section class="section" id="destacados">
		<div class="wrap">
			<div class="section-head">
				<span class="num">01</span>
				<h2>Proyectos destacados</h2>
				<p>Los que hoy tienen usuarios reales o están camino a tenerlos.</p>
			</div>

			<div class="feature-list">
				{
					featured.map((p, i) => (
						<article class="feature" data-reveal>
							<a class="f-media" href={`/proyectos/${p.id}/`} tabindex="-1" aria-hidden="true">
								<Image src={p.data.heroImage} alt={p.data.heroAlt} width={900} height={560} fit={p.data.heroFit} style={`object-fit: ${p.data.heroFit}`} />
							</a>
							<div class="f-body">
								<span class="f-num">0{i + 1}</span>
								<span class="eyebrow">{CATEGORIES[p.data.category]}{p.data.org && ` · ${p.data.org}`}</span>
								<h3><a href={`/proyectos/${p.id}/`}>{p.data.title}</a></h3>
								<p>{p.data.tagline}</p>
								<div class="chips">
									{p.data.stack.slice(0, 5).map((s) => <span class="chip">{s}</span>)}
								</div>
								<span class="f-status">
									<b>●</b> {p.data.status}
								</span>
								<span class="f-links">
									<a class="f-link" href={`/proyectos/${p.id}/`}>Ver detalle →</a>
									{p.data.demo && (
										<a class="f-live" href={p.data.demo} target="_blank" rel="noopener">
											Visitar ↗
										</a>
									)}
								</span>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ============ DATATHON ============ -->
	<section class="section datathon">
		<div class="wrap dt-grid">
			<div class="dt-text" data-reveal>
				<span class="eyebrow lime">02 · Concurso</span>
				<h2>Primer lugar en la <em class="serif-italic">Datathon SUNASS 2026</em></h2>
				<p>
					Con Darick Herrera ganamos la Categoría II —Gestión Comercial y Financiera— de la macrorregión Oriente. La
					propuesta pasó a una pasantía técnica con EMAPA San Martín y terminó como <strong>Yumi</strong>,
					integrado en SYSCO. SEDAPAL y SEDAPAR ya preguntaron por él.
				</p>
				<ul class="dt-points">
					<li><span>01</span>Competencia presencial y formación en ciencia de datos</li>
					<li><span>02</span>Pasantía con EMAPA San Martín (SECOSAN · HELVETAS)</li>
					<li><span>03</span>Implementación en SYSCO junto a ZMC</li>
					<li><span>04</span>Reconocimiento oficial de EMAPA San Martín</li>
				</ul>
				<a class="btn primary" href="/logros/datathon-sunass-2026/">Leer la historia →</a>
			</div>
			<div class="dt-photos">
				<figure class="p1" data-reveal><Image src={dt1} alt="Reconocimiento de SUNASS con autoridades de la UNSM" width={720} /></figure>
				<figure class="p2" data-reveal style="--d:.1s"><Image src={dt2} alt="Equipo ganador frente al banner de la Datathon" width={600} /></figure>
				<figure class="p3" data-reveal style="--d:.2s"><Image src={dt3} alt="Implementación de Yumi en EMAPA San Martín" width={600} /></figure>
			</div>
		</div>
	</section>

	<!-- ============ MÁS PROYECTOS ============ -->
	<section class="section">
		<div class="wrap">
			<div class="section-head">
				<span class="num">03</span>
				<h2>Más proyectos</h2>
				<p>Servicios, herramientas y experimentos que también construí y desplegué.</p>
			</div>
			<div class="cards">
				{others.map((p, i) => <ProjectCard project={p} index={i} />)}
			</div>
		</div>
	</section>

	<!-- ============ INFRA ============ -->
	<section class="section infra">
		<div class="wrap infra-grid">
			<div data-reveal>
				<span class="eyebrow lime">04 · Infraestructura</span>
				<h2>Mi propio servidor, <em class="serif-italic">en producción.</em></h2>
				<p class="muted">
					Además de desarrollar, administro un VPS Linux donde despliego y mantengo aplicaciones reales: contenedores
					Docker, bases de datos MySQL, proxy inverso con Caddy y HTTPS automático, servicios Java y Python, y despliegues
					desde repositorios privados.
				</p>
				<div class="chips">
					<span class="chip water">Ubuntu / Linux</span>
					<span class="chip water">Docker</span>
					<span class="chip water">Caddy · HTTPS</span>
					<span class="chip water">MySQL</span>
					<span class="chip water">SSH · deploy keys</span>
					<span class="chip water">Cloudflare</span>
				</div>
			</div>
			<div class="term beam" data-reveal style="--d:.1s" role="img" aria-label="Servicios desplegados en mi VPS">
				<div class="term-bar"><i></i><i></i><i></i><span>root@vps:/opt</span></div>
				<div class="term-body">
					<div><span class="pr">$</span> docker ps · servicios activos</div>
					{
						deploys.map((d) => (
							<div class="row">
								<span class="ok">●</span> <b>{d.name}</b> <span class="t">{d.tech}</span>
								<div class="n">└ {d.note}</div>
							</div>
						))
					}
					<div><span class="pr">$</span> <span class="cursor">▍</span></div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============ INVESTIGACIÓN ============ -->
	<section class="section">
		<div class="wrap">
			<div class="thesis" data-reveal>
				<span class="eyebrow lime">05 · Investigación</span>
				<blockquote>
					Usabilidad de aplicaciones móviles Android para personas ciegas mediante un agente de voz basado en LLM con
					invocación de funciones.
				</blockquote>
				<p class="muted">
					Mi proyecto de tesis evalúa <strong>MeryApp</strong> con 30 personas ciegas usuarias de TalkBack: tasa de
					tareas completadas, tiempo y carga percibida (SEQ y NASA-TLX). Asesor: Ing. Dr. Miguel Ángel Valles Coral.
				</p>
				<div class="actions">
					<a class="btn" href="/proyectos/meryapp/">Conocer MeryApp →</a>
					<a class="btn" href={AUTHOR.orcid} target="_blank" rel="noopener">ORCID ↗</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ============ LOGROS ============ -->
	<section class="section">
		<div class="wrap">
			<div class="section-head">
				<span class="num">06</span>
				<h2>Logros y participaciones</h2>
				<p>Concursos, ferias, exposiciones y experiencias.</p>
			</div>
			<ol class="mini-tl">
				{
					logros.slice(0, 5).map((l) => (
						<li data-reveal>
							<a href={`/logros/${l.id}/`}>
								<span class="d">{l.data.dateLabel}</span>
								<span class="t">{l.data.title}</span>
								{l.data.result && <span class="chip lime">{l.data.result}</span>}
								<span class="arr">→</span>
							</a>
						</li>
					))
				}
			</ol>
			<a class="btn" href="/logros">Ver todos los logros →</a>
		</div>
	</section>

	<!-- ============ CONTACTO ============ -->
	<section class="section contact" id="contacto">
		<div class="wrap" data-reveal>
			<span class="eyebrow lime">07 · Contacto</span>
			<h2 class="big">¿Tienes un problema que vale la pena resolver?</h2>
			<p class="muted">
				Busco proyectos con impacto real y duradero: entender el requerimiento, construir la solución adecuada y
				ponerla a disposición de quienes la necesitan. Si tienes una propuesta, una pregunta o solo quieres saludar,
				escríbeme.
			</p>
			<a class="btn primary" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email} ↗</a>
		</div>
	</section>
</Base>

<style>
	/* ---- carga escalonada ---- */
	.load {
		animation: rise 1s var(--ease) both;
		animation-delay: calc(var(--i) * 0.12s + 0.1s);
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(26px);
		}
	}

	/* ---- hero ---- */
	.hero {
		display: grid;
		grid-template-columns: 1fr 340px;
		gap: clamp(2rem, 5vw, 5rem);
		align-items: start;
		padding-top: clamp(3rem, 9vw, 7rem);
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}
	.hero h1 {
		margin: 1.4rem 0 1.6rem;
		font-size: clamp(2.5rem, 5.8vw, 4.9rem);
		font-weight: 600;
	}
	.lede {
		font-size: clamp(1.05rem, 1.8vw, 1.3rem);
		color: var(--paper-dim);
		max-width: 54ch;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 2rem;
	}
	.hero-card {
		position: relative;
		border: 1px solid var(--line);
		border-radius: 20px;
		padding: 1.2rem;
		background: linear-gradient(160deg, var(--ink-3), var(--ink-2));
	}
	.portrait {
		border-radius: 14px;
		overflow: hidden;
		aspect-ratio: 1 / 1;
		background: var(--ink);
	}
	.portrait img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 25%;
		filter: saturate(0.9) contrast(1.05);
	}
	.stamp {
		position: absolute;
		top: -34px;
		right: -26px;
		width: 116px;
		height: 116px;
		border-radius: 50%;
		background: var(--lime);
		color: var(--lime-ink);
		display: grid;
		place-items: center;
		box-shadow: 0 10px 40px rgba(255, 255, 255, 0.25);
	}
	.stamp svg {
		position: absolute;
		inset: 0;
		animation: spin 18s linear infinite;
	}
	.stamp text {
		font-family: var(--font-mono);
		font-size: 9.4px;
		letter-spacing: 1.6px;
		fill: var(--lime-ink);
	}
	.stamp span {
		font-family: var(--font-display);
		font-size: 2.2rem;
		font-weight: 600;
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	.hero-card dl {
		margin: 1.1rem 0 0;
		display: grid;
		gap: 0.7rem;
	}
	.hero-card dt {
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.hero-card dd {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.45;
		color: var(--paper-dim);
	}
	.hero-card dl > div {
		padding-top: 0.7rem;
		border-top: 1px solid var(--line-soft);
	}
	.id {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin-top: 1.1rem;
	}
	.id strong {
		font-family: var(--font-display);
		font-size: 1.2rem;
		font-weight: 500;
		line-height: 1.2;
	}
	.id span {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--paper-dim);
	}
	.open {
		display: block;
		margin-top: 1rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--paper);
	}
	.open b {
		color: var(--ok);
		font-weight: 400;
		animation: pulse 2.4s ease-in-out infinite;
	}

	/* ---- marquee ---- */
	.marquee {
		border-block: 1px solid var(--line);
		overflow: hidden;
		padding: 1.1rem 0;
		mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
	}
	.track {
		display: flex;
		width: max-content;
		animation: slide 48s linear infinite;
	}
	.track span {
		font-family: var(--font-mono);
		font-size: clamp(0.95rem, 1.6vw, 1.15rem);
		color: var(--muted);
		padding: 0 1rem;
		white-space: nowrap;
	}
	.track i {
		font-style: normal;
		color: var(--line);
		margin-left: 2rem;
		font-size: 0.8em;
	}
	@keyframes slide {
		to {
			transform: translateX(-50%);
		}
	}

	/* ---- stats ---- */
	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		padding-top: 3.5rem;
	}
	.stats div {
		padding: 0.5rem 1.5rem;
		border-left: 1px solid var(--line);
	}
	.stats strong {
		display: block;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.6rem, 5vw, 4rem);
		line-height: 1;
		color: var(--lime);
		margin-bottom: 0.4rem;
	}
	.stats span {
		font-size: 0.9rem;
		color: var(--paper-dim);
	}
	.server-icon {
		display: block;
		width: 1em;
		height: 1em;
	}

	/* ---- destacados ---- */
	.feature-list {
		display: flex;
		flex-direction: column;
		gap: clamp(3rem, 7vw, 6rem);
	}
	.feature {
		display: grid;
		grid-template-columns: 1.25fr 1fr;
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: center;
		text-decoration: none;
	}
	.feature:nth-child(even) {
		grid-template-columns: 1fr 1.25fr;
	}
	.feature:nth-child(even) .f-media {
		order: 2;
	}
	.f-media {
		display: block;
		border-radius: 18px;
		overflow: hidden;
		border: 1px solid var(--line);
		aspect-ratio: 16 / 10;
		background: var(--ink-3);
		position: relative;
	}
	.f-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
		transition: transform 1s var(--ease);
	}
	.feature:hover .f-media img {
		transform: scale(1.035);
	}
	.feature:hover {
		color: inherit;
	}
	.f-body {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		align-items: flex-start;
	}
	.f-num {
		font-family: var(--font-display);
		font-size: 4.5rem;
		line-height: 0.8;
		font-weight: 300;
		color: transparent;
		-webkit-text-stroke: 1px var(--line);
		transition: -webkit-text-stroke-color 0.4s var(--ease);
	}
	.feature:hover .f-num {
		-webkit-text-stroke-color: var(--lime);
	}
	.f-body h3 {
		font-size: clamp(2rem, 3.6vw, 2.9rem);
		margin: 0;
	}
	.f-body h3 a {
		text-decoration: none;
	}
	.f-body p {
		color: var(--paper-dim);
		margin: 0;
	}
	.f-status {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--paper);
	}
	.f-status b {
		color: var(--ok);
		font-weight: 400;
		animation: pulse 2.4s ease-in-out infinite;
	}
	@keyframes pulse {
		50% {
			opacity: 0.3;
		}
	}
	.f-links {
		display: flex;
		align-items: center;
		gap: 1.2rem;
	}
	.f-live {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		padding: 0.45em 1em;
		border-radius: 8px;
		background: var(--lime);
		color: var(--lime-ink);
		font-weight: 600;
		text-decoration: none;
		transition: background 0.25s var(--ease);
	}
	.f-live:hover {
		background: var(--paper);
		color: var(--ink);
	}
	.f-link {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--lime);
		text-decoration: none;
		border-bottom: 1px solid currentColor;
		padding-bottom: 2px;
	}

	/* ---- datathon ---- */
	.datathon {
		background:
			radial-gradient(700px 400px at 80% 40%, rgba(255, 255, 255, 0.07), transparent 70%),
			var(--ink-2);
		border-block: 1px solid var(--line);
	}
	.dt-grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
	}
	.dt-text h2 {
		margin-top: 1rem;
	}
	.dt-text p {
		color: var(--paper-dim);
	}
	.dt-points {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 2rem;
		border-top: 1px solid var(--line);
	}
	.dt-points li {
